{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    // skipLibCheck: los .d.ts de @tensorflow/tfjs-layers no compilan bajo `strict` — declaran
    // interfaces con índice de string (PyJsonValue) y propiedades opcionales que lo violan.
    // Es un problema de los tipos publicados por la librería, no del código de esta app, y
    // sin esta bandera el build falla con ~10 errores en node_modules que no se pueden
    // arreglar desde acá. El código propio se sigue chequeando con strict completo.
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  }
}
